# ./locales/pt-BR/doctor.ftl
# Doctor check details. Check names (pyenv-bin-on-path) stay as stable IDs.

doctor-root-ok = a raiz existe em { $path }
doctor-root-missing = a raiz ainda não existe em { $path }
doctor-bin-on-path = esperava-se { $path } no PATH
doctor-bin-on-path-desktop = aplicativos da área de trabalho não herdam o PATH do shell. { $path } está configurado para novos terminais após o pyenv init
doctor-shims-on-path = esperava-se { $path } no PATH
doctor-shims-on-path-desktop = aplicativos da área de trabalho não herdam o PATH do shell. { $path } está configurado para novos terminais após o pyenv init
doctor-versions-dir = os interpretadores gerenciados ficam em { $path }
doctor-no-selected-versions = nenhuma versão selecionada
doctor-selected-versions = { $versions } (de { $origin })
doctor-desktop-path-ok = o PATH é fornecido pela inicialização do shell, não por este processo da área de trabalho
doctor-plugin-path-search-on = a descoberta de plugins inclui o PATH; defina plugins.search_path=false para restringir a PYENV_ROOT/plugins e PYENV_PLUGIN_PATH
doctor-plugin-path-search-off = a descoberta de plugins está limitada a PYENV_ROOT/plugins e PYENV_PLUGIN_PATH
doctor-shim-gui-copy = o shim de python é uma cópia de pyenv-gui.exe e abrirá a interface gráfica em vez de executar o Python; execute `pyenv rehash` para reparar
doctor-shim-gui-ref = o shim de python aponta para pyenv-gui e abrirá a interface gráfica em vez de executar o Python; execute `pyenv rehash` para reparar
doctor-shim-launchers-ok = os lançadores de shim apontam para { $path }
doctor-func-skip-no-version = teste funcional ignorado; nenhuma versão do python selecionada
doctor-func-skip-missing = teste funcional ignorado; as versões selecionadas estão ausentes
doctor-func-shim-missing = shim de python não encontrado; execute `pyenv rehash` para gerá-lo
doctor-func-ok = shim funcional; { $version } invocado com sucesso
doctor-func-failed = a invocação do shim falhou (código de saída { $status }): { $error }
doctor-func-launch-failed = falha ao iniciar o shim de python em { $path }: { $error }
doctor-pwsh-ok = PowerShell 7 (pwsh) está no PATH
doctor-pwsh-missing = PowerShell 7 (pwsh) não foi encontrado. O pyenv-native prefere pwsh para plugins .ps1, inicialização do shell e doctor --fix. Instale com: winget install --id Microsoft.PowerShell
doctor-python-build-ok = python-build disponível em { $path }
doctor-python-build-optional = { $error } (compilações nativas do CPython a partir do código-fonte não exigem isso)
doctor-termux-lib-ok = a biblioteca do Termux { $lib } está instalada
doctor-termux-lib-missing = o pacote de biblioteca do Termux { $lib } está ausente; instale-o
doctor-venv-missing = o venv gerenciado selecionado `{ $value }` está ausente; execute `pyenv venv list` para inspecionar os ambientes disponíveis ou `pyenv venv create <runtime> <name>` para recriá-lo
doctor-pyenv-win-root = PYENV_ROOT está definido como `{ $path }`, que parece um caminho do pyenv-win; o pyenv-native substitui isso em tempo de execução, mas recomenda-se remover a variável: remova PYENV_ROOT das variáveis de ambiente do usuário
doctor-command-ok = { $command } disponível em { $path }
doctor-command-missing = { $reason }; buscou-se { $commands }
doctor-cli-missing = lançador CLI do pyenv não encontrado em { $path }; reinstale o pyenv-native ou execute o instalador
doctor-shim-mismatch = o shim de python em { $shim } não corresponde ao lançador CLI do pyenv em { $cli }; execute `pyenv rehash` para atualizar os shims
doctor-source-may-fail = compilações a partir do código-fonte em { $platform } podem falhar até que o shell, o make e o compilador necessários estejam disponíveis
doctor-source-ok = os pré-requisitos de compilação a partir do código-fonte em { $platform } parecem estar no PATH
doctor-reason-shell = necessário para executar o script configure
doctor-reason-make = necessário para compilações nativas do CPython a partir do código-fonte
doctor-reason-compiler = necessário para compilações nativas do CPython a partir do código-fonte
doctor-reason-pkg-config = recomendado para localizar dependências de bibliotecas nativas
doctor-store-alias = o python do sistema resolve para o alias do WindowsApps em { $path }; essa «armadilha» pode interceptar comandos e deve ser desativada em «Configurações > Aplicativos > Aliases de execução de aplicativos»
doctor-system-python = o python do sistema resolve para { $path }
doctor-no-system-python = nenhum python do sistema encontrado no PATH
doctor-pyenv-win-path = entradas do pyenv-win aparecem antes do pyenv-native no PATH; isso pode fazer o pyenv-win interceptar comandos. Remova as entradas do pyenv-win do PATH do usuário: { $path }
doctor-fix-ensure-layout = Criar os diretórios gerenciados ausentes em { $path }
doctor-fix-rehash = Atualizar os lançadores shim em { $path }
doctor-fix-path-shims = Adicionar { $path } ao PATH do shell para que python/pip resolvam pelos shims do pyenv
doctor-fix-path-bin = Adicionar o diretório bin do pyenv ao PATH do shell
doctor-fix-pyenv-win-root = Remover a variável de ambiente PYENV_ROOT obsoleta do pyenv-win
doctor-fix-store-alias = Desativar o alias de execução do app Python da Microsoft Store para evitar interceptação do PATH
doctor-fix-pwsh7 = Instalar o PowerShell 7 (pwsh) para ganchos de plugin e init do shell
doctor-fix-termux-deps = Instalar as ferramentas e cabeçalhos de compilação do Termux que faltam ({ $packages })
doctor-fix-xcode-clt = Instalar ou atualizar as Xcode Command Line Tools necessárias para builds CPython a partir da fonte
doctor-fix-openssl-brew = Instalar os cabeçalhos Homebrew OpenSSL necessários para builds CPython com TLS
doctor-fix-source-deps = Instalar os pré-requisitos nativos de build a partir da fonte exigidos em { $platform }
doctor-fix-missing-venv = Recriar ou redirecionar a seleção de venv gerenciado ausente `{ $value }`
