# ./locales/pt-BR/install.ftl
# Installer-facing copy. Command names and paths stay English.

install-downloading = Baixando pyenv-native { $version }
install-extracting = Extraindo o pacote da versão
install-installing = Instalando em { $path }
install-done = pyenv-native instalado. Abra um novo terminal e execute `pyenv doctor`.
install-failed = A instalação falhou
install-lang-help = Idioma da interface para as mensagens do instalador
install-summary-title = Resumo da instalação do pyenv-native
install-network-summary-title = Resumo da instalação em rede do pyenv-native
install-summary-blurb = Isto criará ou atualizará uma instalação portátil do pyenv-native na raiz selecionada.
install-summary-blurb-detail = Instala o pyenv, o servidor pyenv-mcp amigável a agentes e o companheiro GUI quando disponível, grava um log de instalação e executa verificações básicas.
install-network-blurb = Isto baixará um pacote publicado do pyenv-native, verificará o checksum SHA-256 e o instalará na raiz portátil selecionada.
install-profile-yes = O perfil do shell será atualizado para que sessões futuras encontrem o pyenv-native automaticamente.
install-profile-yes-pwsh = O perfil do PowerShell será atualizado para que sessões futuras encontrem o pyenv-native automaticamente.
install-profile-no = Nenhuma alteração será feita no perfil do shell.
install-profile-no-pwsh = Nenhuma alteração será feita no perfil do PowerShell.
install-continue = Continuar a instalação? [y/N]:
install-need-yes = Instalações interativas exigem confirmação. Execute de novo com --yes para uso não interativo.
install-need-yes-pwsh = Instalações interativas exigem confirmação. Execute de novo com -Yes para uso não interativo.
install-cancelled = Instalação cancelada.
install-installed-to = pyenv-native instalado em { $path }
install-installed-command = Comando instalado: { $path }
install-installed-mcp = Servidor MCP instalado: { $path }
install-mcp-helper = Assistente de configuração MCP: { $command }
install-installed-gui = GUI instalada: { $path }
install-log-file = Arquivo de log: { $path }
