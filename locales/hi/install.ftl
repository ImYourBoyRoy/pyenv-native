# ./locales/hi/install.ftl
# Installer-facing copy. Command names and paths stay English.

install-downloading = pyenv-native { $version } डाउनलोड हो रहा है
install-extracting = रिलीज़ बंडल निकाला जा रहा है
install-installing = { $path } में स्थापित हो रहा है
install-done = pyenv-native स्थापित हो गया। नया टर्मिनल खोलें, फिर `pyenv doctor` चलाएँ।
install-failed = स्थापना विफल
install-lang-help = इंस्टॉलर संदेशों के लिए इंटरफ़ेस भाषा
install-summary-title = pyenv-native स्थापना सारांश
install-network-summary-title = pyenv-native नेटवर्क स्थापना सारांश
install-summary-blurb = यह चयनित रूट के अंतर्गत एक पोर्टेबल pyenv-native स्थापना बनाएगा या अपडेट करेगा।
install-summary-blurb-detail = यह pyenv, एजेंट-अनुकूल pyenv-mcp सर्वर और उपलब्ध होने पर GUI साथी स्थापित करता है, स्थापना लॉग लिखता है, और मूल जाँच चलाता है।
install-network-blurb = यह प्रकाशित pyenv-native बंडल डाउनलोड करेगा, SHA-256 चेकसम सत्यापित करेगा, और चयनित पोर्टेबल रूट में स्थापित करेगा।
install-profile-yes = आपकी शेल प्रोफ़ाइल अपडेट की जाएगी ताकि भविष्य के सत्र pyenv-native अपने आप पा सकें।
install-profile-yes-pwsh = आपकी PowerShell प्रोफ़ाइल अपडेट की जाएगी ताकि भविष्य के सत्र pyenv-native अपने आप पा सकें।
install-profile-no = शेल प्रोफ़ाइल में कोई बदलाव नहीं किया जाएगा।
install-profile-no-pwsh = PowerShell प्रोफ़ाइल में कोई बदलाव नहीं किया जाएगा।
install-continue = स्थापना जारी रखें? [y/N]:
install-need-yes = इंटरैक्टिव स्थापना के लिए पुष्टि आवश्यक है। गैर-इंटरैक्टिव उपयोग के लिए --yes के साथ फिर चलाएँ।
install-need-yes-pwsh = इंटरैक्टिव स्थापना के लिए पुष्टि आवश्यक है। गैर-इंटरैक्टिव उपयोग के लिए -Yes के साथ फिर चलाएँ।
install-cancelled = स्थापना रद्द।
install-installed-to = pyenv-native { $path } में स्थापित हुआ
install-installed-command = स्थापित कमांड: { $path }
install-installed-mcp = स्थापित MCP सर्वर: { $path }
install-mcp-helper = MCP कॉन्फ़िग सहायक: { $command }
install-installed-gui = स्थापित GUI: { $path }
install-log-file = लॉग फ़ाइल: { $path }
