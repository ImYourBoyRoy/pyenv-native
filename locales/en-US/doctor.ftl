# ./locales/en-US/doctor.ftl
# Doctor check details. Check names (pyenv-bin-on-path) stay as stable IDs.

doctor-root-ok = root exists at { $path }
doctor-root-missing = root does not exist yet at { $path }
doctor-bin-on-path = expected { $path } on PATH
doctor-bin-on-path-desktop = desktop apps do not inherit shell PATH. { $path } is configured for new terminals after pyenv init
doctor-shims-on-path = expected { $path } on PATH
doctor-shims-on-path-desktop = desktop apps do not inherit shell PATH. { $path } is configured for new terminals after pyenv init
doctor-versions-dir = managed runtimes live under { $path }
doctor-no-selected-versions = no selected versions
doctor-selected-versions = { $versions } (from { $origin })
doctor-desktop-path-ok = PATH is provided by shell init, not this desktop process
doctor-plugin-path-search-on = plugin discovery includes PATH; set plugins.search_path=false to restrict to PYENV_ROOT/plugins and PYENV_PLUGIN_PATH
doctor-plugin-path-search-off = plugin discovery is limited to PYENV_ROOT/plugins and PYENV_PLUGIN_PATH
doctor-shim-gui-copy = python shim is a copy of pyenv-gui.exe and will open the GUI instead of running Python; run `pyenv rehash` to repair
doctor-shim-gui-ref = python shim references pyenv-gui and will open the GUI instead of running Python; run `pyenv rehash` to repair
doctor-shim-launchers-ok = shim launchers reference { $path }
doctor-func-skip-no-version = skipped functional test; no python version selected
doctor-func-skip-missing = skipped functional test; selected versions are missing
doctor-func-shim-missing = python shim not found; run `pyenv rehash` to generate it
doctor-func-ok = shim functional; successfully invoked { $version }
doctor-func-failed = shim invocation failed (exit status { $status }): { $error }
doctor-func-launch-failed = failed to launch python shim at { $path }: { $error }
doctor-pwsh-ok = PowerShell 7 (pwsh) is on PATH
doctor-pwsh-missing = PowerShell 7 (pwsh) was not found. pyenv-native prefers pwsh for .ps1 plugins, shell init, and doctor --fix. Install with: winget install --id Microsoft.PowerShell
doctor-python-build-ok = python-build available at { $path }
doctor-python-build-optional = { $error } (native CPython source builds do not require it)
doctor-termux-lib-ok = Termux library { $lib } is installed
doctor-termux-lib-missing = Termux library package { $lib } is missing; please install it
doctor-venv-missing = selected managed venv `{ $value }` is missing; run `pyenv venv list` to inspect available envs or `pyenv venv create <runtime> <name>` to recreate it
doctor-pyenv-win-root = PYENV_ROOT is set to `{ $path }` which looks like a pyenv-win path; pyenv-native overrides this at runtime, but removing the env var is recommended: remove PYENV_ROOT from your User environment variables
doctor-command-ok = { $command } available at { $path }
doctor-command-missing = { $reason }; searched for { $commands }
doctor-cli-missing = pyenv CLI launcher not found at { $path }; reinstall pyenv-native or run the installer
doctor-shim-mismatch = python shim at { $shim } does not match the pyenv CLI launcher at { $cli }; run `pyenv rehash` to refresh shims
doctor-source-may-fail = { $platform } source builds may fail until the required shell, make, and compiler tooling are available
doctor-source-ok = { $platform } source-build prerequisites look available on PATH
doctor-reason-shell = required for configure-script execution
doctor-reason-make = required for native CPython source builds
doctor-reason-compiler = required for native CPython source builds
doctor-reason-pkg-config = recommended for locating native library dependencies
doctor-store-alias = system python resolves to a WindowsApps alias at { $path }; this stub can intercept python when it is ahead of pyenv shims. Self-healing removes the App Installer python.exe / python3.exe stubs. Turning those aliases off in Settings is optional and only prevents Windows from recreating them
doctor-store-alias-shadowed = Microsoft Store python stub is present at { $path }; pyenv shims take precedence, so removing it is optional. Windows 11: Settings > Apps > Advanced app settings > App execution aliases
doctor-system-python = system python resolves to { $path }
doctor-no-system-python = no system python found on PATH
doctor-pyenv-win-path = pyenv-win PATH entries appear before pyenv-native in PATH; this can cause pyenv-win to intercept commands. Remove pyenv-win entries from your User PATH: { $path }
doctor-fix-ensure-layout = Create missing managed directories under { $path }
doctor-fix-rehash = Refresh shim launchers under { $path }
doctor-fix-path-shims = Add { $path } to your shell PATH so python/pip resolve through pyenv shims
doctor-fix-path-bin = Add the pyenv bin directory to your shell PATH
doctor-fix-pyenv-win-root = Remove the stale pyenv-win PYENV_ROOT environment variable
doctor-fix-store-alias = Remove the App Installer python.exe and python3.exe stubs from WindowsApps so they cannot intercept PATH
doctor-fix-store-alias-settings = Optional: turn off App Installer python.exe and python3.exe in Settings so Windows does not recreate the stubs
doctor-fix-pwsh7 = Install PowerShell 7 (pwsh) for plugin hooks and shell init
doctor-fix-termux-deps = Install missing Termux compilation tools and headers ({ $packages })
doctor-fix-xcode-clt = Install or update Xcode Command Line Tools required for CPython source builds
doctor-fix-openssl-brew = Install Homebrew OpenSSL headers required for TLS-capable CPython builds
doctor-fix-source-deps = Install the native source-build prerequisites required on { $platform }
doctor-fix-missing-venv = Recreate or repoint the missing managed venv selection `{ $value }`
