# ./locales/de/doctor.ftl
# Doctor check details. Check names (pyenv-bin-on-path) stay as stable IDs.

doctor-root-ok = Stammverzeichnis vorhanden unter { $path }
doctor-root-missing = Stammverzeichnis existiert noch nicht unter { $path }
doctor-bin-on-path = { $path } auf PATH erwartet
doctor-bin-on-path-desktop = Desktop-Apps erben nicht den Shell-PATH. { $path } ist für neue Terminals nach pyenv init konfiguriert
doctor-shims-on-path = { $path } auf PATH erwartet
doctor-shims-on-path-desktop = Desktop-Apps erben nicht den Shell-PATH. { $path } ist für neue Terminals nach pyenv init konfiguriert
doctor-versions-dir = verwaltete Laufzeiten liegen unter { $path }
doctor-no-selected-versions = keine Versionen ausgewählt
doctor-selected-versions = { $versions } (von { $origin })
doctor-desktop-path-ok = PATH wird durch die Shell-Initialisierung bereitgestellt, nicht durch diesen Desktop-Prozess
doctor-plugin-path-search-on = Plugin-Erkennung schließt PATH ein; plugins.search_path=false setzen, um auf PYENV_ROOT/plugins und PYENV_PLUGIN_PATH zu beschränken
doctor-plugin-path-search-off = Plugin-Erkennung ist auf PYENV_ROOT/plugins und PYENV_PLUGIN_PATH beschränkt
doctor-shim-gui-copy = python-Shim ist eine Kopie von pyenv-gui.exe und öffnet die GUI statt Python auszuführen; zum Reparieren `pyenv rehash` ausführen
doctor-shim-gui-ref = python-Shim verweist auf pyenv-gui und öffnet die GUI statt Python auszuführen; zum Reparieren `pyenv rehash` ausführen
doctor-shim-launchers-ok = Shim-Starter verweisen auf { $path }
doctor-func-skip-no-version = Funktionstest übersprungen; keine python-Version ausgewählt
doctor-func-skip-missing = Funktionstest übersprungen; ausgewählte Versionen fehlen
doctor-func-shim-missing = python-Shim nicht gefunden; mit `pyenv rehash` erzeugen
doctor-func-ok = Shim funktionsfähig; { $version } erfolgreich aufgerufen
doctor-func-failed = Shim-Aufruf fehlgeschlagen (Exit-Status { $status }): { $error }
doctor-func-launch-failed = python-Shim unter { $path } konnte nicht gestartet werden: { $error }
doctor-pwsh-ok = PowerShell 7 (pwsh) ist auf PATH
doctor-pwsh-missing = PowerShell 7 (pwsh) wurde nicht gefunden. pyenv-native bevorzugt pwsh für .ps1-Plugins, Shell-Init und doctor --fix. Installation mit: winget install --id Microsoft.PowerShell
doctor-python-build-ok = python-build verfügbar unter { $path }
doctor-python-build-optional = { $error } (native CPython-Quellbuilds benötigen es nicht)
doctor-termux-lib-ok = Termux-Bibliothek { $lib } ist installiert
doctor-termux-lib-missing = Termux-Bibliothekspaket { $lib } fehlt; bitte installieren
doctor-venv-missing = ausgewähltes verwaltetes venv `{ $value }` fehlt; mit `pyenv venv list` verfügbare Umgebungen prüfen oder mit `pyenv venv create <runtime> <name>` neu erstellen
doctor-pyenv-win-root = PYENV_ROOT ist auf `{ $path }` gesetzt, was nach einem pyenv-win-Pfad aussieht; pyenv-native überschreibt dies zur Laufzeit, aber das Entfernen der Umgebungsvariable wird empfohlen: PYENV_ROOT aus den Benutzerumgebungsvariablen entfernen
doctor-command-ok = { $command } verfügbar unter { $path }
doctor-command-missing = { $reason }; gesucht nach { $commands }
doctor-cli-missing = pyenv-CLI-Starter nicht gefunden unter { $path }; pyenv-native neu installieren oder den Installer ausführen
doctor-shim-mismatch = python-Shim unter { $shim } stimmt nicht mit dem pyenv-CLI-Starter unter { $cli } überein; Shims mit `pyenv rehash` aktualisieren
doctor-source-may-fail = { $platform }-Quellbuilds können fehlschlagen, bis die erforderlichen Shell-, make- und Compiler-Werkzeuge verfügbar sind
doctor-source-ok = { $platform }-Quellbuild-Voraussetzungen scheinen auf PATH verfügbar zu sein
doctor-reason-shell = erforderlich für die Ausführung des configure-Skripts
doctor-reason-make = erforderlich für native CPython-Quellbuilds
doctor-reason-compiler = erforderlich für native CPython-Quellbuilds
doctor-reason-pkg-config = empfohlen zum Finden nativer Bibliotheksabhängigkeiten
doctor-store-alias = System-python löst zum WindowsApps-Alias unter { $path } auf; diese „Falle“ kann Befehle abfangen und sollte unter „Einstellungen > Apps > Aliase für die App-Ausführung“ deaktiviert werden
doctor-system-python = System-python löst zu { $path } auf
doctor-no-system-python = kein System-python auf PATH gefunden
doctor-pyenv-win-path = pyenv-win-PATH-Einträge stehen vor pyenv-native in PATH; dadurch kann pyenv-win Befehle abfangen. pyenv-win-Einträge aus dem Benutzer-PATH entfernen: { $path }
doctor-fix-ensure-layout = Fehlende verwaltete Verzeichnisse unter { $path } erstellen
doctor-fix-rehash = Shim-Starter unter { $path } aktualisieren
doctor-fix-path-shims = { $path } zum Shell-PATH hinzufügen, damit python/pip über pyenv-Shims aufgelöst werden
doctor-fix-path-bin = Das pyenv-bin-Verzeichnis zum Shell-PATH hinzufügen
doctor-fix-pyenv-win-root = Die veraltete pyenv-win-Umgebungsvariable PYENV_ROOT entfernen
doctor-fix-store-alias = Den Microsoft-Store-Python-App-Ausführungsalias deaktivieren, um PATH-Abfangung zu vermeiden
doctor-fix-pwsh7 = PowerShell 7 (pwsh) für Plugin-Hooks und Shell-Init installieren
doctor-fix-termux-deps = Fehlende Termux-Kompilierwerkzeuge und Header installieren ({ $packages })
doctor-fix-xcode-clt = Xcode Command Line Tools installieren oder aktualisieren, die für CPython-Quellbuilds nötig sind
doctor-fix-openssl-brew = Homebrew-OpenSSL-Header installieren, die für TLS-fähige CPython-Builds nötig sind
doctor-fix-source-deps = Die nativen Quellbuild-Voraussetzungen installieren, die auf { $platform } erforderlich sind
doctor-fix-missing-venv = Die fehlende verwaltete venv-Auswahl `{ $value }` neu erstellen oder neu zuweisen
