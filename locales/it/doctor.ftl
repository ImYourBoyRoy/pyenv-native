# ./locales/it/doctor.ftl
# Doctor check details. Check names (pyenv-bin-on-path) stay as stable IDs.

doctor-root-ok = la radice esiste in { $path }
doctor-root-missing = la radice non esiste ancora in { $path }
doctor-bin-on-path = previsto { $path } in PATH
doctor-bin-on-path-desktop = le app desktop non ereditano il PATH della shell. { $path } è configurato per i nuovi terminali dopo pyenv init
doctor-shims-on-path = previsto { $path } in PATH
doctor-shims-on-path-desktop = le app desktop non ereditano il PATH della shell. { $path } è configurato per i nuovi terminali dopo pyenv init
doctor-versions-dir = gli interpreti gestiti si trovano in { $path }
doctor-no-selected-versions = nessuna versione selezionata
doctor-selected-versions = { $versions } (da { $origin })
doctor-desktop-path-ok = PATH è fornito dall’inizializzazione della shell, non da questo processo desktop
doctor-plugin-path-search-on = l’individuazione dei plugin include PATH; impostare plugins.search_path=false per limitarla a PYENV_ROOT/plugins e PYENV_PLUGIN_PATH
doctor-plugin-path-search-off = l’individuazione dei plugin è limitata a PYENV_ROOT/plugins e PYENV_PLUGIN_PATH
doctor-shim-gui-copy = lo shim di python è una copia di pyenv-gui.exe e aprirà l’interfaccia grafica invece di eseguire Python; eseguire `pyenv rehash` per ripararlo
doctor-shim-gui-ref = lo shim di python fa riferimento a pyenv-gui e aprirà l’interfaccia grafica invece di eseguire Python; eseguire `pyenv rehash` per ripararlo
doctor-shim-launchers-ok = i lanciatori degli shim fanno riferimento a { $path }
doctor-func-skip-no-version = test funzionale saltato; nessuna versione di python selezionata
doctor-func-skip-missing = test funzionale saltato; le versioni selezionate sono assenti
doctor-func-shim-missing = shim di python non trovato; eseguire `pyenv rehash` per generarlo
doctor-func-ok = shim funzionante; { $version } invocato correttamente
doctor-func-failed = invocazione dello shim non riuscita (codice di uscita { $status }): { $error }
doctor-func-launch-failed = impossibile avviare lo shim di python in { $path }: { $error }
doctor-pwsh-ok = PowerShell 7 (pwsh) è in PATH
doctor-pwsh-missing = PowerShell 7 (pwsh) non è stato trovato. pyenv-native preferisce pwsh per i plugin .ps1, l’inizializzazione della shell e doctor --fix. Installazione: winget install --id Microsoft.PowerShell
doctor-python-build-ok = python-build disponibile in { $path }
doctor-python-build-optional = { $error } (le compilazioni native di CPython dal codice sorgente non lo richiedono)
doctor-termux-lib-ok = la libreria Termux { $lib } è installata
doctor-termux-lib-missing = manca il pacchetto di libreria Termux { $lib }; installarlo
doctor-venv-missing = il venv gestito selezionato `{ $value }` è assente; eseguire `pyenv venv list` per ispezionare gli ambienti disponibili o `pyenv venv create <runtime> <name>` per ricrearlo
doctor-pyenv-win-root = PYENV_ROOT è impostato su `{ $path }`, che sembra un percorso pyenv-win; pyenv-native lo sostituisce in fase di esecuzione, ma è consigliabile rimuovere la variabile: togliere PYENV_ROOT dalle variabili d’ambiente utente
doctor-command-ok = { $command } disponibile in { $path }
doctor-command-missing = { $reason }; ricerca effettuata per { $commands }
doctor-cli-missing = launcher CLI di pyenv non trovato in { $path }; reinstallare pyenv-native o eseguire il programma di installazione
doctor-shim-mismatch = lo shim di python in { $shim } non corrisponde al launcher CLI di pyenv in { $cli }; eseguire `pyenv rehash` per aggiornare gli shim
doctor-source-may-fail = le compilazioni dal codice sorgente su { $platform } possono non riuscire finché non sono disponibili shell, make e compilatore richiesti
doctor-source-ok = i prerequisiti di compilazione dal codice sorgente su { $platform } sembrano disponibili in PATH
doctor-reason-shell = necessario per l’esecuzione dello script configure
doctor-reason-make = necessario per le compilazioni native di CPython dal codice sorgente
doctor-reason-compiler = necessario per le compilazioni native di CPython dal codice sorgente
doctor-reason-pkg-config = consigliato per individuare le dipendenze delle librerie native
doctor-store-alias = il python di sistema risolve all’alias WindowsApps in { $path }; questa «trappola» può intercettare i comandi e andrebbe disattivata in «Impostazioni > App > Alias di esecuzione app»
doctor-system-python = il python di sistema risolve a { $path }
doctor-no-system-python = nessun python di sistema trovato in PATH
doctor-pyenv-win-path = voci pyenv-win compaiono prima di pyenv-native in PATH; pyenv-win può intercettare i comandi. Rimuovere le voci pyenv-win dal PATH utente: { $path }
doctor-fix-ensure-layout = Creare le directory gestite mancanti in { $path }
doctor-fix-rehash = Aggiorna i launcher shim in { $path }
doctor-fix-path-shims = Aggiungere { $path } al PATH della shell così python/pip si risolvono tramite gli shim pyenv
doctor-fix-path-bin = Aggiungi la directory bin di pyenv al PATH della shell
doctor-fix-pyenv-win-root = Rimuovere la variabile d’ambiente PYENV_ROOT obsoleta di pyenv-win
doctor-fix-store-alias = Disattivare l’alias di esecuzione dell’app Python del Microsoft Store per evitare l’intercettazione del PATH
doctor-fix-pwsh7 = Installa PowerShell 7 (pwsh) per gli hook dei plugin e l’init della shell
doctor-fix-termux-deps = Installare gli strumenti e le intestazioni di compilazione Termux mancanti ({ $packages })
doctor-fix-xcode-clt = Installare o aggiornare gli Xcode Command Line Tools richiesti per le build CPython da sorgente
doctor-fix-openssl-brew = Installare le intestazioni Homebrew OpenSSL richieste per le build CPython con TLS
doctor-fix-source-deps = Installare i prerequisiti nativi di compilazione da sorgente richiesti su { $platform }
doctor-fix-missing-venv = Ricreare o riassegnare la selezione venv gestita mancante `{ $value }`
