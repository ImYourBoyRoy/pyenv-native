# ./locales/fr/doctor.ftl
# Doctor check details. Check names (pyenv-bin-on-path) stay as stable IDs.

doctor-root-ok = la racine existe à { $path }
doctor-root-missing = la racine n’existe pas encore à { $path }
doctor-bin-on-path = { $path } attendu dans PATH
doctor-bin-on-path-desktop = les applications de bureau n’héritent pas du PATH du shell. { $path } est configuré pour les nouveaux terminaux après pyenv init
doctor-shims-on-path = { $path } attendu dans PATH
doctor-shims-on-path-desktop = les applications de bureau n’héritent pas du PATH du shell. { $path } est configuré pour les nouveaux terminaux après pyenv init
doctor-versions-dir = les interpréteurs gérés se trouvent sous { $path }
doctor-no-selected-versions = aucune version sélectionnée
doctor-selected-versions = { $versions } (depuis { $origin })
doctor-desktop-path-ok = PATH est fourni par l’initialisation du shell, pas par ce processus de bureau
doctor-plugin-path-search-on = la découverte des plugins inclut PATH ; définissez plugins.search_path=false pour la limiter à PYENV_ROOT/plugins et PYENV_PLUGIN_PATH
doctor-plugin-path-search-off = la découverte des plugins est limitée à PYENV_ROOT/plugins et PYENV_PLUGIN_PATH
doctor-shim-gui-copy = le shim python est une copie de pyenv-gui.exe et ouvrira l’interface graphique au lieu d’exécuter Python ; exécutez `pyenv rehash` pour le réparer
doctor-shim-gui-ref = le shim python référence pyenv-gui et ouvrira l’interface graphique au lieu d’exécuter Python ; exécutez `pyenv rehash` pour le réparer
doctor-shim-launchers-ok = les lanceurs de shims référencent { $path }
doctor-func-skip-no-version = test fonctionnel ignoré ; aucune version python sélectionnée
doctor-func-skip-missing = test fonctionnel ignoré ; les versions sélectionnées sont absentes
doctor-func-shim-missing = shim python introuvable ; exécutez `pyenv rehash` pour le générer
doctor-func-ok = shim fonctionnel ; { $version } invoqué avec succès
doctor-func-failed = échec de l’invocation du shim (code de sortie { $status }) : { $error }
doctor-func-launch-failed = échec du lancement du shim python à { $path } : { $error }
doctor-pwsh-ok = PowerShell 7 (pwsh) est dans PATH
doctor-pwsh-missing = PowerShell 7 (pwsh) est introuvable. pyenv-native préfère pwsh pour les plugins .ps1, l’initialisation du shell et doctor --fix. Installation : winget install --id Microsoft.PowerShell
doctor-python-build-ok = python-build disponible à { $path }
doctor-python-build-optional = { $error } (les compilations natives CPython depuis les sources n’en ont pas besoin)
doctor-termux-lib-ok = la bibliothèque Termux { $lib } est installée
doctor-termux-lib-missing = le paquet de bibliothèque Termux { $lib } est manquant ; veuillez l’installer
doctor-venv-missing = le venv géré sélectionné `{ $value }` est manquant ; exécutez `pyenv venv list` pour inspecter les environnements disponibles ou `pyenv venv create <runtime> <name>` pour le recréer
doctor-pyenv-win-root = PYENV_ROOT vaut `{ $path }`, ce qui ressemble à un chemin pyenv-win ; pyenv-native le remplace à l’exécution, mais il est recommandé de supprimer la variable : retirez PYENV_ROOT des variables d’environnement utilisateur
doctor-command-ok = { $command } disponible à { $path }
doctor-command-missing = { $reason } ; recherche effectuée pour { $commands }
doctor-cli-missing = lanceur CLI pyenv introuvable à { $path } ; réinstallez pyenv-native ou exécutez l’installateur
doctor-shim-mismatch = le shim python à { $shim } ne correspond pas au lanceur CLI pyenv à { $cli } ; exécutez `pyenv rehash` pour actualiser les shims
doctor-source-may-fail = les compilations depuis les sources sur { $platform } peuvent échouer tant que le shell, make et le compilateur requis ne sont pas disponibles
doctor-source-ok = les prérequis de compilation depuis les sources sur { $platform } semblent présents dans PATH
doctor-reason-shell = requis pour l’exécution du script configure
doctor-reason-make = requis pour les compilations natives CPython depuis les sources
doctor-reason-compiler = requis pour les compilations natives CPython depuis les sources
doctor-reason-pkg-config = recommandé pour localiser les dépendances de bibliothèques natives
doctor-store-alias = le python système résout vers l’alias WindowsApps à { $path } ; ce stub peut intercepter python s’il précède les shims pyenv. Désactivez python.exe / python3.exe dans Paramètres > Applications > Alias d’exécution d’application
doctor-store-alias-shadowed = le stub python du Microsoft Store est présent à { $path } ; les shims pyenv ont la priorité, donc le désactiver dans Paramètres > Applications > Alias d’exécution d’application est facultatif
doctor-system-python = le python système résout vers { $path }
doctor-no-system-python = aucun python système trouvé dans PATH
doctor-pyenv-win-path = des entrées pyenv-win apparaissent avant pyenv-native dans PATH ; pyenv-win peut intercepter les commandes. Retirez les entrées pyenv-win du PATH utilisateur : { $path }
doctor-fix-ensure-layout = Créer les répertoires gérés manquants sous { $path }
doctor-fix-rehash = Actualiser les lanceurs shim sous { $path }
doctor-fix-path-shims = Ajouter { $path } au PATH du shell afin que python/pip se résolvent via les shims pyenv
doctor-fix-path-bin = Ajouter le répertoire bin de pyenv au PATH du shell
doctor-fix-pyenv-win-root = Supprimer la variable d’environnement PYENV_ROOT obsolète de pyenv-win
doctor-fix-store-alias = Désactiver l’alias d’exécution de l’app Python du Microsoft Store pour éviter l’interception du PATH
doctor-fix-pwsh7 = Installer PowerShell 7 (pwsh) pour les hooks de plugin et l’init du shell
doctor-fix-termux-deps = Installer les outils et en-têtes de compilation Termux manquants ({ $packages })
doctor-fix-xcode-clt = Installer ou mettre à jour les Xcode Command Line Tools requis pour les compilations CPython source
doctor-fix-openssl-brew = Installer les en-têtes Homebrew OpenSSL requis pour les compilations CPython avec TLS
doctor-fix-source-deps = Installer les prérequis natifs de compilation source requis sur { $platform }
doctor-fix-missing-venv = Recréer ou réorienter la sélection de venv géré manquante `{ $value }`
