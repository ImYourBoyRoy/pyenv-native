# ./locales/fa/install.ftl
# Installer-facing copy. Command names and paths stay English.

install-downloading = در حال بارگیری pyenv-native { $version }
install-extracting = در حال استخراج بستهٔ انتشار
install-installing = در حال نصب در { $path }
install-done = pyenv-native نصب شد. یک پایانهٔ جدید باز کنید، سپس `pyenv doctor` را اجرا کنید.
install-failed = نصب ناموفق بود
install-lang-help = زبان رابط برای پیام‌های نصب‌کننده
install-summary-title = خلاصهٔ نصب pyenv-native
install-network-summary-title = خلاصهٔ نصب شبکه‌ای pyenv-native
install-summary-blurb = این کار یک نصب قابل‌حمل pyenv-native را در ریشهٔ انتخاب‌شده ایجاد یا به‌روزرسانی می‌کند.
install-summary-blurb-detail = pyenv، کارساز pyenv-mcp دوستدار عامل، و همراه GUI در صورت موجود بودن را نصب می‌کند، گزارش نصب می‌نویسد و بررسی‌های پایه انجام می‌دهد.
install-network-blurb = یک بستهٔ منتشرشدهٔ pyenv-native را بارگیری می‌کند، جمع‌آزمای SHA-256 را راستی‌آزمایی می‌کند و آن را در ریشهٔ قابل‌حمل انتخاب‌شده نصب می‌کند.
install-profile-yes = نمایهٔ پوسته به‌روزرسانی می‌شود تا نشست‌های بعدی pyenv-native را خودکار پیدا کنند.
install-profile-yes-pwsh = نمایهٔ PowerShell به‌روزرسانی می‌شود تا نشست‌های بعدی pyenv-native را خودکار پیدا کنند.
install-profile-no = هیچ تغییری در نمایهٔ پوسته اعمال نخواهد شد.
install-profile-no-pwsh = هیچ تغییری در نمایهٔ PowerShell اعمال نخواهد شد.
install-continue = نصب ادامه یابد؟ [y/N]:
install-need-yes = نصب تعاملی به تأیید نیاز دارد. برای استفادهٔ غیرتعاملی با --yes دوباره اجرا کنید.
install-need-yes-pwsh = نصب تعاملی به تأیید نیاز دارد. برای استفادهٔ غیرتعاملی با -Yes دوباره اجرا کنید.
install-cancelled = نصب لغو شد.
install-installed-to = pyenv-native در { $path } نصب شد
install-installed-command = فرمان نصب‌شده: { $path }
install-installed-mcp = کارساز MCP نصب‌شده: { $path }
install-mcp-helper = یاور پیکربندی MCP: { $command }
install-installed-gui = GUI نصب‌شده: { $path }
install-log-file = پروندهٔ گزارش: { $path }
