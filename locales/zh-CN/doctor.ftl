# ./locales/zh-CN/doctor.ftl
# Doctor check details. Check names (pyenv-bin-on-path) stay as stable IDs.

doctor-root-ok = 根目录位于 { $path }
doctor-root-missing = 根目录尚不存在：{ $path }
doctor-bin-on-path = PATH 中应包含 { $path }
doctor-bin-on-path-desktop = 桌面应用不会继承 shell 的 PATH。{ $path } 已在新终端中通过 pyenv init 配置
doctor-shims-on-path = PATH 中应包含 { $path }
doctor-shims-on-path-desktop = 桌面应用不会继承 shell 的 PATH。{ $path } 已在新终端中通过 pyenv init 配置
doctor-versions-dir = 托管运行时位于 { $path }
doctor-no-selected-versions = 尚未选择版本
doctor-selected-versions = { $versions }（来自 { $origin }）
doctor-desktop-path-ok = PATH 由 shell 初始化提供，而非此桌面进程
doctor-plugin-path-search-on = 插件发现会搜索 PATH；将 plugins.search_path=false 可限制为 PYENV_ROOT/plugins 和 PYENV_PLUGIN_PATH
doctor-plugin-path-search-off = 插件发现仅限于 PYENV_ROOT/plugins 和 PYENV_PLUGIN_PATH
doctor-shim-gui-copy = python shim 是 pyenv-gui.exe 的副本，会打开图形界面而不是运行 Python；请运行 `pyenv rehash` 修复
doctor-shim-gui-ref = python shim 指向 pyenv-gui，会打开图形界面而不是运行 Python；请运行 `pyenv rehash` 修复
doctor-shim-launchers-ok = shim 启动器指向 { $path }
doctor-func-skip-no-version = 已跳过功能测试：尚未选择 python 版本
doctor-func-skip-missing = 已跳过功能测试：所选版本缺失
doctor-func-shim-missing = 未找到 python shim；请运行 `pyenv rehash` 生成
doctor-func-ok = shim 工作正常；已成功调用 { $version }
doctor-func-failed = shim 调用失败（退出状态 { $status }）：{ $error }
doctor-func-launch-failed = 无法启动 { $path } 处的 python shim：{ $error }
doctor-pwsh-ok = PATH 中已有 PowerShell 7 (pwsh)
doctor-pwsh-missing = 未找到 PowerShell 7 (pwsh)。pyenv-native 在 .ps1 插件、shell 初始化和 doctor --fix 中优先使用 pwsh。安装命令：winget install --id Microsoft.PowerShell
doctor-python-build-ok = python-build 位于 { $path }
doctor-python-build-optional = { $error }（原生 CPython 源码构建不需要它）
doctor-termux-lib-ok = 已安装 Termux 库 { $lib }
doctor-termux-lib-missing = 缺少 Termux 库软件包 { $lib }；请安装
doctor-venv-missing = 所选托管虚拟环境 `{ $value }` 不存在；运行 `pyenv venv list` 查看可用环境，或运行 `pyenv venv create <runtime> <name>` 重新创建
doctor-pyenv-win-root = PYENV_ROOT 设置为 `{ $path }`，看起来像 pyenv-win 路径；pyenv-native 会在运行时覆盖它，但建议删除该环境变量：从用户环境变量中移除 PYENV_ROOT
doctor-command-ok = { $command } 位于 { $path }
doctor-command-missing = { $reason }；已搜索 { $commands }
doctor-cli-missing = 未在 { $path } 找到 pyenv CLI 启动器；请重新安装 pyenv-native 或运行安装程序
doctor-shim-mismatch = { $shim } 处的 python shim 与 { $cli } 处的 pyenv CLI 启动器不匹配；请运行 `pyenv rehash` 刷新 shim
doctor-source-may-fail = 在所需的 shell、make 和编译器工具就绪之前，{ $platform } 源码构建可能会失败
doctor-source-ok = { $platform } 源码构建的前置工具看起来已在 PATH 中
doctor-reason-shell = 执行 configure 脚本所必需
doctor-reason-make = 原生 CPython 源码构建所必需
doctor-reason-compiler = 原生 CPython 源码构建所必需
doctor-reason-pkg-config = 用于定位原生库依赖（建议安装）
doctor-store-alias = 系统 python 解析为 { $path } 处的 WindowsApps 别名；当该存根排在 pyenv shims 之前时会拦截 python。请在“设置 > 应用 > 应用执行别名”中关闭 python.exe / python3.exe
doctor-store-alias-shadowed = Microsoft Store 的 python 存根位于 { $path }；pyenv shims 优先，因此在“设置 > 应用 > 应用执行别名”中关闭它是可选的
doctor-system-python = 系统 python 解析为 { $path }
doctor-no-system-python = PATH 中未找到系统 python
doctor-pyenv-win-path = PATH 中 pyenv-win 条目位于 pyenv-native 之前，可能导致 pyenv-win 拦截命令。请从用户 PATH 中移除 pyenv-win 条目：{ $path }
doctor-fix-ensure-layout = 在 { $path } 下创建缺失的托管目录
doctor-fix-rehash = 刷新 { $path } 下的 shim 启动器
doctor-fix-path-shims = 将 { $path } 加入 shell PATH，使 python/pip 通过 pyenv shim 解析
doctor-fix-path-bin = 将 pyenv bin 目录加入 shell PATH
doctor-fix-pyenv-win-root = 删除过时的 pyenv-win PYENV_ROOT 环境变量
doctor-fix-store-alias = 禁用 Microsoft Store Python 应用执行别名，避免 PATH 拦截
doctor-fix-pwsh7 = 安装 PowerShell 7 (pwsh) 以支持插件钩子和 shell 初始化
doctor-fix-termux-deps = 安装缺失的 Termux 编译工具和头文件（{ $packages }）
doctor-fix-xcode-clt = 安装或更新 CPython 源码构建所需的 Xcode 命令行工具
doctor-fix-openssl-brew = 安装 Homebrew OpenSSL 头文件，供支持 TLS 的 CPython 构建使用
doctor-fix-source-deps = 安装 { $platform } 上源码构建所需的原生前置条件
doctor-fix-missing-venv = 重建或重新指向缺失的托管 venv 选择 `{ $value }`
