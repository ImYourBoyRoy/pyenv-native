{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pyenv Native",
  "version": "0.6.0",
  "identifier": "com.pyenv-native.gui",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": ["main-capability"],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://api.github.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Pyenv Native",
        "width": 1024,
        "height": 720,
        "transparent": true,
        "decorations": false,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
